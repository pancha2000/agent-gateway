# --- VPS gateway ---
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_API_KEY=3569db0cfaee68244c04be055c8b0ccabf7402c929c3ba12

# --- Ollama on this laptop ---
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=mainai
NUM_CTX=4096
THINK=0
KEEP_ALIVE=30m
NUM_GPU=37
EMBED_OLLAMA_URL=http://127.0.0.1:11435
EMBED_ON_CPU=0

# Embedding model. nomic-embed-text = 768 dims -> EMBED_DIM=768 on the VPS.
# (all-minilm = 384 dims.) `ollama pull nomic-embed-text`
EMBED_MODEL=nomic-embed-text
# 1 = run embeddings on the CPU so they never fight the chat model for the 6 GB of VRAM
EMBED_ON_CPU=1

# --- who is talking? ---
# 'shared' sees only shared memories. A role name (coder, security, ...) sees shared + its own.
AGENT_SCOPE=shared
# 1 = main agent: ignore scopes and see everything
ALL_SCOPES=0
# optional project tag: limits searches to that project + general knowledge
PROJECT_ID=
