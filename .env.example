# ---- required --------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=paste_your_turso_token
GATEWAY_API_KEY=use_at_least_16_random_characters_here

# ---- vectors ---------------------------------------------------------------
# MUST match the embedding model on your PC:
#   nomic-embed-text = 768 (recommended)    all-minilm / bge-small = 384
# Changing it later means recreating the tables.
EMBED_DIM=768
# false = exact scan (fine to ~50k rows). true = Turso DiskANN index (approximate, cheaper reads).
USE_VECTOR_INDEX=false

# ---- web -------------------------------------------------------------------
# DuckDuckGo often blocks datacenter IPs. A Brave Search API key is more reliable.
BRAVE_API_KEY=
WEB_TIMEOUT_SECONDS=8
WEB_MAX_PAGE_BYTES=400000
WEB_MAX_PAGE_CHARS=4000

# ---- ingest / research limits (RAM guards for a 1 GB VPS) -------------------
PDF_MAX_BYTES=6000000
PDF_MAX_PAGES=80
INGEST_MAX_CHARS=150000
RESEARCH_PAGE_CHARS=12000
CHUNK_CHARS=1200
CHUNK_OVERLAP=150

# ---- misc ------------------------------------------------------------------
ENABLE_DOCS=false
MAX_BODY_BYTES=2000000
